generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

enum AccessCodeStatus {
  UNUSED
  USED
}

model User {
  id           Int      @id @default(autoincrement())
  accessCode   String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?
}

model Student {
  id           Int    @id @default(autoincrement())
  userId       Int    @unique
  accessCode   String @unique
  name         String
  passwordHash String
  classId      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentAccessCode StudentAccessCode @relation(fields: [accessCode], references: [code], onDelete: Restrict)
  class            SchoolClass?      @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([classId])
}

model StudentAccessCode {
  id        Int              @id @default(autoincrement())
  code      String           @unique
  status    AccessCodeStatus @default(UNUSED)
  createdAt DateTime         @default(now())
  usedAt    DateTime?

  student Student?
}

model Announcement {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  imageUrl    String?
  isPublished Boolean   @default(true)
  publishedAt DateTime? @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Department {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  name      String
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  classes   SchoolClass[]
}

model SchoolClass {
  id           Int         @id @default(autoincrement())
  grade        String
  number       Int
  departmentId Int?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  students     Student[]

  @@unique([grade, number, departmentId])
  @@index([departmentId])
}
