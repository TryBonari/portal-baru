generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

enum AccessCodeStatus {
  UNUSED
  USED
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum StudentStatus {
  AKTIF
  NONAKTIF
  LULUS
  KELUAR
  CUTI
}

model User {
  id           Int      @id @default(autoincrement())
  accessCode   String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALPA
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  date      DateTime         // Tanggal absensi (biasanya dinormalkan ke awal hari)
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
}

model Student {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  accessCode   String        @unique
  name         String
  passwordHash String
  avatarUrl    String?
  nis          String?       @unique
  nisn         String?       @unique
  gender       Gender?
  birthPlace   String?
  birthDate    DateTime?
  admissionYear Int?
  status       StudentStatus @default(AKTIF)
  classId      Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentAccessCode StudentAccessCode @relation(fields: [accessCode], references: [code], onDelete: Restrict)
  class             SchoolClass?      @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacherComplaints TeacherComplaint[]
  attendances       Attendance[]

  @@index([classId])
  @@index([status])
}

model StudentAccessCode {
  id        Int              @id @default(autoincrement())
  code      String           @unique
  status    AccessCodeStatus @default(UNUSED)
  createdAt DateTime         @default(now())
  usedAt    DateTime?

  student Student?
}

model Announcement {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  imageUrl    String?
  isPublished Boolean   @default(true)
  publishedAt DateTime? @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Department {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  name      String
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  classes   SchoolClass[]
}

model Teacher {
  id          Int      @id @default(autoincrement())
  teacherCode String?  @unique
  name        String
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  subjects    String?  // Untuk menyimpan mapel yang diajarkan (comma separated atau JSON string)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes          SchoolClass[]
  complaints       TeacherComplaint[]
  schedules        Schedule[]
}

model TeacherComplaint {
  id        Int      @id @default(autoincrement())
  teacherId Int
  studentId Int
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([studentId])
}

model Subject {
  id        Int           @id @default(autoincrement())
  code      String?       @unique
  name      String
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  schedules Schedule[]
}

model Schedule {
  id              Int      @id @default(autoincrement())
  classId         Int
  subjectId       Int
  teacherId       Int
  day             String
  startTime       String
  endTime         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
}

model SchoolClass {
  id           Int         @id @default(autoincrement())
  grade        String
  number       Int
  departmentId Int?
  isActive     Boolean     @default(true)
  homeroomTeacherId Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  homeroomTeacher Teacher? @relation(fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  students     Student[]
  schedules    Schedule[]

  @@unique([grade, number, departmentId])
  @@index([departmentId])
  @@index([homeroomTeacherId])
}
